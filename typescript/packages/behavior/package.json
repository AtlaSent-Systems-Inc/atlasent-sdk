{
  "name": "@atlasent/behavior",
  "version": "1.0.0",
  "private": false,
  "description": "AtlaSent behavior conditioning helpers",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
