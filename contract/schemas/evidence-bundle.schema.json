{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://atlasent.io/schemas/evidence-bundle/v1.json",
  "title": "AtlaSent Evidence Bundle (v1)",
  "description": "Wire format for an Ed25519-signed, offline-verifiable evidence bundle. Mirrors atlasent-docs/architecture/evidence-bundles-spec.md §4.1. Consumed by the reference verifiers in python/atlasent/evidence_bundle_verifier.py and typescript/src/evidence-bundle-verifier.ts.",
  "type": "object",
  "required": ["bundle_id", "bundle_version", "issued_at", "issued_by", "chain_context", "records", "summary_hash", "signature"],
  "properties": {
    "$schema": { "type": "string" },
    "bundle_id": { "type": "string", "description": "UUIDv7" },
    "bundle_version": { "type": "string", "const": "1" },
    "issued_at": { "type": "string", "description": "RFC3339 UTC" },
    "issued_by": {
      "type": "object",
      "required": ["org_id", "issuer_kind", "issuer_version"],
      "properties": {
        "org_id": { "type": "string" },
        "issuer_kind": { "type": "string" },
        "issuer_version": { "type": "string" }
      }
    },
    "scope": {
      "type": "object",
      "properties": {
        "kind": { "type": "string" },
        "from": { "type": "string" },
        "to": { "type": "string" },
        "filters": { "type": "object" },
        "decision_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "chain_context": {
      "type": "object",
      "required": ["first_entry_hash", "first_prev_hash", "last_entry_hash", "entry_count"],
      "properties": {
        "chain_id": { "type": "string" },
        "first_entry_hash": { "type": "string", "description": "SHA-256 hex" },
        "first_prev_hash": { "type": "string", "description": "SHA-256 hex" },
        "last_entry_hash": { "type": "string", "description": "SHA-256 hex" },
        "entry_count": { "type": "integer", "minimum": 0 }
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["decision_id", "entry_hash", "prev_hash"],
        "properties": {
          "decision_id": { "type": "string" },
          "entry_hash": { "type": "string", "description": "SHA-256 hex of canonical(record without entry_hash/prev_hash)" },
          "prev_hash": { "type": "string", "description": "SHA-256 hex; links to the prior record's entry_hash" },
          "decision": { "type": "object" },
          "permit_token_metadata": { "type": "object" },
          "approval_chain": { "type": "object" }
        }
      }
    },
    "summary_hash": { "type": "string", "description": "RFC 6962 Merkle root (hex) over the record entry_hash leaves" },
    "signature": {
      "type": "object",
      "required": ["alg", "key_id", "signature_b64"],
      "properties": {
        "alg": { "type": "string", "const": "Ed25519" },
        "key_id": { "type": "string" },
        "key_set_url": { "type": "string" },
        "signature_b64": { "type": "string", "description": "base64 Ed25519 signature over SHA-256(canonical bundle, signature field omitted)" }
      }
    }
  }
}
