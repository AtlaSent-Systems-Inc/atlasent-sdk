{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlasent.io/schemas/engine-version-record",
  "title": "EngineVersionRecord",
  "type": "object",
  "properties": {
    "engine_version": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*@[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "type": "string",
      "enum": ["active", "retired", "archival"]
    },
    "bundle_compatibility_range": {
      "oneOf": [
        { "type": "string" },
        { "type": "null" }
      ]
    },
    "supersedes_version": {
      "oneOf": [
        { "type": "string" },
        { "type": "null" }
      ]
    },
    "released_at": {
      "type": "string",
      "format": "date-time"
    },
    "retired_at": {
      "oneOf": [
        { "type": "string", "format": "date-time" },
        { "type": "null" }
      ]
    },
    "archival_until": {
      "oneOf": [
        { "type": "string", "format": "date-time" },
        { "type": "null" }
      ]
    },
    "notes": {
      "oneOf": [
        { "type": "string" },
        { "type": "null" }
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "engine_version",
    "status",
    "released_at",
    "created_at",
    "updated_at"
  ],
  "additionalProperties": false
}
